# Python and tooling
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Secrets and credentials, never commit
.env/
.env*
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.jks
*.keystore
secrets*
credentials*
*password*
*token*

# ELSTER and ERiC material, never commit
# The ERiC licence (section 4) only allows shipping ERiC built into a product.
# Its documentation, schemas and samples may not be published.
ERiC-*/
Dokumentation/
Beispiel/
ericdemo*/
ottodemo*/
*.xsd
*.xsl
*.xslt
*.jar
*.chm
ELSTER-ERiC*/
*.zip
*.dylib
*.so
*.dll
# Tax returns, receipts and previews carry personal data
*.xml
!tests/fixtures/**/*.xml
*.pdf
returns/
receipts/
# ERiC logs can contain return content
*.log
logs/
.elster-mcp/

# Local and editor files
.claude/
.idea/
.vscode/
.DS_Store
*.swp
